{
  "name": "dsh-selection-actions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "description": "DSH Web GUI plugin: add a selected conversation fragment to the current chat as a citation, or open it in a parallel side chat.",
  "license": "MIT",
  "author": "ccclosed",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "citation",
    "quote",
    "selection",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccclosed/dsh-selection-actions.git"
  },
  "homepage": "https://github.com/ccclosed/dsh-selection-actions#readme",
  "bugs": {
    "url": "https://github.com/ccclosed/dsh-selection-actions/issues"
  }
}
